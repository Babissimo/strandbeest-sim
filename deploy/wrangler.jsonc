{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strandbeest-sim",
  "compatibility_date": "2026-10-02",
  // Static files only: no Worker script, so every request is served straight from site/, with
  // the headers in site/_headers.
  "assets": {
    "directory": "../site"
  },
  "routes": [
    { "pattern": "strandbeests.babissimo.net", "custom_domain": true }
  ],
  // One canonical address rather than a second copy on workers.dev.
  "workers_dev": false,
  "preview_urls": false
}
